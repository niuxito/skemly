[cto|CTO] -> [eng1|Backend Lead]@icon=Server
[cto|CTO] -> [eng2|Frontend Lead]@icon=Monitor
[cto|CTO] -> [eng3|Infra Lead]@icon=Cloud

[cpo|CPO] -> [pm1|Product Manager]@icon=ClipboardList
[cpo|CPO] -> [des1|Head of Design]@icon=Pen

[cfo|CFO] -> [fin1|Finance Manager]@icon=TrendingUp
[cfo|CFO] -> [leg1|Legal Counsel]@icon=Scale

[eng1|Backend Lead] -> [dev1|Backend Dev ×3]
